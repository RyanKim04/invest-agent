# Copy to .env. Never commit .env.

# App database. Laptop: the app-db compose service. VM: Neon's direct (non-pooled) URL.
# On the laptop, Neon settings go in .env.neon so these commands never touch Neon.
INVEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/invest
# Owner role for `invest db migrate`. Leave empty on the laptop to reuse the URL above.
INVEST_MIGRATE_DATABASE_URL=

# dbt connects as a login user that is a member of invest_dbt.
DBT_PG_HOST=localhost
DBT_PG_PORT=5433
DBT_PG_USER=postgres
DBT_PG_PASSWORD=postgres
DBT_PG_DBNAME=invest
DBT_PG_SSLMODE=prefer

# Database tests create and drop throwaway databases through this superuser URL.
INVEST_TEST_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/postgres

# Airflow. Generate the secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
# Airflow's metadata DB password. Defaults to `airflow`; set a real one on the VM before the
# first `compose up`, because Postgres reads it only when the volume is created.
AIRFLOW_DB_PASSWORD=
# Optional: encrypts Airflow connections. `cryptography`'s Fernet.generate_key().
AIRFLOW_FERNET_KEY=

# Sources (F1). Free tiers.
# SEC asks for a name and contact email, e.g. "Jane Doe jane@example.com".
SEC_USER_AGENT=
# https://finnhub.io/register
FINNHUB_API_KEY=
# https://www.tiingo.com/account/api/token
TIINGO_API_KEY=
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# https://app.alpaca.markets (free account; API keys from the paper-trading dashboard)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# https://eodhd.com (free: 20 calls/day + 500 welcome calls; news costs 5 + 5 per ticker)
EODHD_API_KEY=
# https://site.financialmodelingprep.com (free key)
FMP_API_KEY=
# TipRanks MCP developer key (tr_live_...). Free: 50 requests/month. See docs/source-probe.md
TIPRANKS_API_KEY=
